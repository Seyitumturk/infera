## 5: Components & Conventions

- Components accept `className` and forward `aria`/`label` props.
- Use Radix for dialogs/menus/tabs; theme via tokens.

**Copy patterns:**

```tsx
// components/ui/Button.tsx
"use client";
import { cva } from "class-variance-authority";
import { cn } from "@/lib/cn";
const styles = cva(
  "inline-flex items-center justify-center rounded-lg border transition-all duration-smooth focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent",
  { variants:{
      variant:{
        primary:"bg-accent text-white border-accent hover:shadow-elevation1 hover:-translate-y-0.5 active:translate-y-0",
        ghost:"bg-transparent text-text border-border hover:bg-surface/60 hover:shadow-ambient",
        glass:"bg-glass border-glassBorder backdrop-blur-glass backdrop-saturate-glass hover:shadow-elevation2"
      },
      size:{ sm:"h-9 px-3 text-xs", md:"h-10 px-4 text-base", lg:"h-11 px-6 text-lg" }
    },
    defaultVariants:{ variant:"primary", size:"md" }
  }
);
export function Button({ className, variant, size, ...props }){
  return <button className={cn(styles({ variant, size }), className)} {...props} />
}

// components/ui/Card.tsx - Glassmorphic floating card
export function Card({ className, children, elevated = false, ...props }) {
  return (
    <div
      className={cn(
        "rounded-lg border border-glassBorder bg-glass backdrop-blur-glass backdrop-saturate-glass transition-all duration-smooth",
        elevated ? "shadow-elevation2 hover:shadow-elevation3 hover:-translate-y-1" : "shadow-elevation1",
        className
      )}
      {...props}
    >
      {children}
    </div>
  )
}

```

